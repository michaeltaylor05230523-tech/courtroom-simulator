    display: flex;
    align-items: center;
    gap: 6px;
    margin-top: 6px;
    font-size: 0.75rem;
  }
  .pressure-track {
    flex: 1;
    height: 10px;
    background: #e0e0e0;
    border-radius: 5px;
    overflow: hidden;
  }
  .pressure-fill {
    height: 100%;
    border-radius: 5px;
    transition: width 0.4s ease;
  }
  .pressure-low { background: #66bb6a; }
  .pressure-med { background: #ffa726; }
  .pressure-high { background: #ef5350; }
  .hub-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    margin-top: 12px;
  }
  .hub-card {
    background: #fff;
    border: 2px solid #8d6e63;
    border-radius: 10px;
    padding: 16px;
    text-align: center;
    cursor: pointer;
    transition: all 0.2s;
  }
  .hub-card:hover {
    border-color: #b8860b;
    background: #fff8e1;
    transform: translateY(-2px);
  }
  .hub-card h4 { margin: 0 0 6px 0; color: #3e2723; }
  .hub-card p { margin: 0; font-size: 0.8rem; color: #555; }
  .hub-icon { font-size: 1.6rem; margin-bottom: 6px; }
  .roster-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.75rem;
  }
  .roster-table th, .roster-table td {
    border: 1px solid #8d6e63;
    padding: 5px;
    text-align: left;
  }
  .roster-table th {
    background: #3e2723;
    color: #ffd700;
  }
  .roster-table tr:nth-child(even) { background: #f5e6c8; }
  .roster-table tr:hover { background: #fff8e1; }
  .parole-card {
    background: #e8f5e9;
    border: 2px solid #1b5e20;
    border-radius: 8px;
    padding: 14px;
    margin-bottom: 12px;
  }
  .parole-stat {
    display: flex;
    justify-content: space-between;
    margin: 6px 0;
    font-size: 0.85rem;
  }
  .dp-phase {
    background: #ffebee;
    border: 2px solid #b71c1c;
    border-radius: 8px;
    padding: 14px;
    margin-bottom: 12px;
  }
  .factor-box {
    background: #fff;
    border: 1px solid #8d6e63;
    border-radius: 6px;
    padding: 8px;
    margin: 6px 0;
