    if(r>=1 && roll<0.15) c=generateRICOCase();
    else if(r>=2 && roll<0.25) c=generateCapitalCase();
    else c=generateCase();
    c.mediaHeadline=generateMediaHeadline(c,false);
    S.calendar.push(c);
  }
}

