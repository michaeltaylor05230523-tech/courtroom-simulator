    let badgeClass='badge-b';
    if(c.type==='jury') badgeClass='badge-j';
    if(c.capital) badgeClass='badge-c';
    if(c.rico) badgeClass='badge-r';
    let badgeText=c.type==='jury'?'Jury':'Bench';
    if(c.capital) badgeText='Capital';
    if(c.rico) badgeText='RICO';
    html+=`<div class="cal-day ${i===S.currentCaseIndex?'active':''}">
      <div class="cal-title">${c.id}</div>
      <div class="cal-type">${c.charge} <span class="badge ${badgeClass}">${badgeText}</span></div>
    </div>`;
  });
  list.innerHTML=html||'<em style="font-size:0.75rem;color:#777;">No cases scheduled.</em>';
}

