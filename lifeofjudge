        <h4>Hold Trial</h4>
        <p>Next case: ${S.calendar[S.currentCaseIndex]?S.calendar[S.currentCaseIndex].charge:'None'}</p>
      </div>
      <div class="hub-card" onclick="checkParole()">
        <div class="hub-icon">🔓</div>
        <h4>Parole Hearing</h4>
        <p>Review eligible inmates for early release</p>
      </div>
      <div class="hub-card" onclick="showRoster()">
        <div class="hub-icon">📋</div>
        <h4>Inmate Roster</h4>
        <p>View all incarcerated defendants</p>
      </div>
      <div class="hub-card" onclick="advanceDay()">
        <div class="hub-icon">📅</div>
        <h4>Next Day</h4>
        <p>Advance time, inmates serve sentences</p>
      </div>
    </div>
    ${S.mediaHeadlines.length?`<div class="media-box"><h4>📰 Latest Headline</h4><div class="media-headline">"${S.mediaHeadlines[S.mediaHeadlines.length-1]}"</div></div>`:''}
  `);
}

function startNextCase(){
  if(S.currentCaseIndex>=S.calendar.length){
    fillCalendar();
    S.currentCaseIndex=0;
    updateStats();
    renderCalendar();
  }
  loadCase(S.currentCaseIndex);
}


function loadCase(index){
  if(index>=S.calendar.length){drawHub();return;}
  S.currentCaseIndex=index;
  S.selectedEvidence.clear();
  S.currentWitnessIndex=0;
  S.verdict=null;
  S.sentence=null;
  S.ricoVerdicts={};
  S.currentDefendantIndex=0;
  updateStats();
  renderCalendar();

  const c=S.calendar[index];
  S.mediaPressure=Math.min(100,S.mediaPressure+randInt(5,15));

  let html=`<div class="card">
    <h3>Case #${c.id} `;
  if(c.rico) html+=`<span class="badge badge-r">RICO</span>`;
  else if(c.capital) html+=`<span class="badge badge-c">Capital</span>`;
  else html+=`<span class="badge ${c.type==='jury'?'badge-j':'badge-b'}">${c.type==='jury'?'Jury':'Bench'}</span>`;
  html+=`</h3>
    <div class="meta">
      <strong>Charge:</strong> ${c.charge}<br>
      <strong>Defendant:</strong> ${c.defendant}<br>
      <strong>Prosecution:</strong> ${c.pros}<br>
      <strong>Defense:</strong> ${c.def}
    </div>`;

  if(c.type==='jury'&&!c.rico){
    let gv=0;
    c.evidence.forEach(e=>{if(e.weight>0.3)gv++;else if(e.weight<-0.3)gv--;});
    gv=Math.max(3,Math.min(10,gv+6));
    html+=`<div class="jury-box">
      <h4>🧑‍⚖️ Jury Deliberation</h4>
      <div class="jury-row">
        <span>Guilty: <span style="color:#ef5350;font-weight:bold;">${gv}</span>/12</span>
        <span>Not Guilty: <span style="color:#66bb6a;font-weight:bold;">${12-gv}</span>/12</span>
      </div>
    </div>`;
  }
  html+=`</div>`;

  if(c.rico&&c.defendants){
    html+=`<div class="card"><h3>🎯 Conspiracy Evidence</h3>`;
    c.evidence.forEach((e,idx)=>{
      html+=`<div class="evidence-item" onclick="toggleEvidence(${idx})" id="ev-tag-${idx}">${e.name}</div>
             <div class="evidence-desc" id="ev-desc-${idx}">${e.desc}</div>`;
    });
    html+=`</div>`;
    html+=`<div class="card"><h3>👥 Co-Defendants</h3>`;
    c.defendants.forEach((d,didx)=>{
      html+=`<div class="defendant-row" id="def-row-${didx}">
        <h4>${d.name} — ${d.charge}</h4>
        <div style="font-size:0.8rem;color:#555;margin-bottom:6px;">Evidence: ${d.evidence.map(e=>e.name).join(', ')}</div>
        <div class="verdict-btns">
          <button class="btn btn-green" style="font-size:0.75rem;padding:5px 10px;" onclick="setRICOVerdict(${didx},'guilty')">Guilty</button>
          <button class="btn btn-red" style="font-size:0.75rem;padding:5px 10px;" onclick="setRICOVerdict(${didx},'not_guilty')">Not Guilty</button>
          <span id="rico-v-${didx}" style="margin-left:10px;font-weight:bold;font-size:0.85rem;"></span>
        </div>
      </div>`;
    });
    html+=`</div>`;
    html+=`<div style="margin-top:8px;text-align:center;">
      <button class="btn btn-navy" onclick="confirmRICOVerdicts()">Deliver Verdicts</button>
    </div>`;
  } else {
    html+=`<div class="card"><h3>📁 Evidence <span style="font-size:0.75rem;color:#666;font-weight:normal;">(click to examine)</span></h3>`;
    c.evidence.forEach((e,idx)=>{
      html+=`<div class="evidence-item" onclick="toggleEvidence(${idx})" id="ev-tag-${idx}">${e.name}</div>
             <div class="evidence-desc" id="ev-desc-${idx}">${e.desc} <em style="color:#777;">(Weight: ${e.weight>0?'+':''}${e.weight})</em></div>`;
    });
    html+=`</div>`;

    html+=`<div class="card"><h3>🎤 Witness Testimony</h3><div id="wit-box"></div>
      <button class="btn btn-wood" onclick="nextWitness()">Next Witness</button>
    </div>`;

    html+=`<div style="margin-top:8px;">
      <button class="btn btn-green" onclick="doVerdict('guilty')">⚖️ Guilty</button>
      <button class="btn btn-red" onclick="doVerdict('not_guilty')">✋ Not Guilty</button>
    </div>`;
  }

  if(c.mediaHeadline){
    html=`<div class="media-box"><h4>📰 Media Pressure</h4><div class="media-headline">"${c.mediaHeadline}"</div>
      <div class="pressure-bar"><span>Pressure:</span><div class="pressure-track"><div class="pressure-fill ${S.mediaPressure<40?'pressure-low':S.mediaPressure<75?'pressure-med':'pressure-high'}" style="width:${S.mediaPressure}%"></div></div><span>${S.mediaPressure}%</span></div>
    </div>`+html;
  }

  setMain(html);
  if(!c.rico) drawWitnesses();
}

function toggleEvidence(idx){
  const c=S.calendar[S.currentCaseIndex];
  const tag=document.getElementById('ev-tag-'+idx);
  const desc=document.getElementById('ev-desc-'+idx);
  if(!tag)return;
  tag.classList.toggle('selected');
  desc.classList.toggle('open');
  const ev=c.rico?c.evidence[idx]:c.evidence[idx];
  if(S.selectedEvidence.has(ev.id)) S.selectedEvidence.delete(ev.id);
  else S.selectedEvidence.add(ev.id);
}

function drawWitnesses(){
  const c=S.calendar[S.currentCaseIndex];
  const box=document.getElementById('wit-box');
  if(!box)return;
  let html='';
  for(let i=0;i<=S.currentWitnessIndex&&i<c.witnesses.length;i++){
    const w=c.witnesses[i];
    html+=`<div class="witness"><div class="witness-name">${w.name}</div><div class="witness-role">${w.role}</div><div class="witness-text">"${w.text}"</div></div>`;
  }
  box.innerHTML=html;
}

function nextWitness(){
  const c=S.calendar[S.currentCaseIndex];
  if(S.currentWitnessIndex<c.witnesses.length-1){
    S.currentWitnessIndex++;
    drawWitnesses();
  }
}

function doVerdict(v){
  S.verdict=v;
  const c=S.calendar[S.currentCaseIndex];
  if(v==='not_guilty'){showResult();return;}
  if(c.capital){
    showDeathPenaltyPhase();
    return;
  }
  let html=`<div class="card"><h3>⚖️ Sentencing</h3>
    <p><strong>${c.defendant}</strong> found <strong style="color:#b71c1c;">GUILTY</strong> of <strong>${c.charge}</strong>.</p>
    <p>Consider severity, public safety, and justice.</p>
    <div style="background:#f5e6c8;border:2px solid #b8860b;border-radius:8px;padding:14px;text-align:center;margin-top:10px;">
      <div style="font-weight:bold;color:#3e2723;margin-bottom:8px;">Select Sentence</div>`;
  c.sentences.forEach((s,i)=>{
    html+=`<button class="sentence-btn" onclick="selectSentence(${i})" id="snt-${i}">${s.label}</button>`;
  });
  html+=`</div><div style="text-align:center;margin-top:12px;"><button class="btn btn-navy" onclick="confirmSentence()">Deliver Sentence</button></div></div>`;
  setMain(html);
  S.sentence=null;
}

function selectSentence(i){
  S.sentence=i;
  document.querySelectorAll('.sentence-btn').forEach(b=>b.classList.remove('selected'));
  const el=document.getElementById('snt-'+i);
  if(el) el.classList.add('selected');
}

function confirmSentence(){
  if(S.sentence===null){alert('Please select a sentence first.');return;}
  showResult();
}

// ==================== DEATH PENALTY PHASE ====================
function showDeathPenaltyPhase(){
  const c=S.calendar[S.currentCaseIndex];
  const ags=[];
  const mis=[];
  const used=new Set();
  while(ags.length<3){
    const f=randItem(AGGRAVATING_FACTORS);
    if(!used.has(f.text)){ags.push(f);used.add(f.text);}
  }
  while(mis.length<3){
    const f=randItem(MITIGATING_FACTORS);
    if(!used.has(f.text)){mis.push(f);used.add(f.text);}
  }
  let agTotal=ags.reduce((a,b)=>a+b.weight,0);
  let miTotal=mis.reduce((a,b)=>a+b.weight,0);
  let rec=agTotal+miTotal>0.3?"Death":"Life Imprisonment";

  let html=`<div class="card"><h3>☠️ Death Penalty Phase</h3>
    <p><strong>${c.defendant}</strong> has been found <strong style="color:#b71c1c;">GUILTY</strong> of <strong>${c.charge}</strong>.</p>
    <p>The jury must now determine whether the aggravating circumstances outweigh the mitigating circumstances.</p>
  </div>`;

  html+=`<div class="dp-phase"><h4 style="margin:0 0 8px 0;color:#b71c1c;">⚠️ Aggravating Factors</h4>`;
  ags.forEach(a=>{
    html+=`<div class="factor-box factor-ag">${a.text} <em style="color:#777;">(Weight: +${a.weight})</em></div>`;
  });
  html+=`</div>`;

  html+=`<div class="card" style="border-color:#1b5e20;"><h4 style="margin:0 0 8px 0;color:#1b5e20;">✅ Mitigating Factors</h4>`;
  mis.forEach(m=>{
    html+=`<div class="factor-box factor-mi">${m.text} <em style="color:#777;">(Weight: ${m.weight})</em></div>`;
  });
  html+=`</div>`;

  html+=`<div class="card"><h4>🧑‍⚖️ Jury Recommendation</h4>
    <p>The jury recommends: <strong style="color:${rec==='Death'?'#b71c1c':'#1b5e20'};">${rec}</strong></p>
    <p>You may accept or override this recommendation. The final decision rests with the court.</p>
    <div style="text-align:center;margin-top:10px;">
      <button class="btn btn-red" onclick="selectDPSentence(0)">Death Penalty</button>
      <button class="btn btn-navy" onclick="selectDPSentence(1)">Life Without Parole</button>
      <button class="btn btn-green" onclick="selectDPSentence(2)">Life With Parole</button>
      <button class="btn btn-wood" onclick="selectDPSentence(3)">30 Years</button>
    </div>
    <div style="text-align:center;margin-top:12px;">
      <button class="btn btn-gold" onclick="confirmDPSentence()">Deliver Final Sentence</button>
    </div>
  </div>`;

  setMain(html);
  S.sentence=null;
}

function selectDPSentence(i){
  S.sentence=i;
  document.querySelectorAll('.btn-red,.btn-navy,.btn-green,.btn-wood').forEach(b=>b.style.outline='none');
  const btns=document.querySelectorAll('.content .btn');
  const target=[btns[btns.length-5],btns[btns.length-4],btns[btns.length-3],btns[btns.length-2]][i];
  if(target) target.style.outline='3px solid #ffd700';
}

function confirmDPSentence(){
  if(S.sentence===null){alert('Please select a sentence first.');return;}
  showResult();
}

// ==================== RICO VERDICTS ====================
function setRICOVerdict(didx,verdict){
  S.ricoVerdicts[didx]=verdict;
  const span=document.getElementById('rico-v-'+didx);
  if(span) span.textContent=verdict==='guilty'?'GUILTY':'NOT GUILTY';
  if(span) span.style.color=verdict==='guilty'?'#b71c1c':'#1b5e20';
}

function confirmRICOVerdicts(){
  const c=S.calendar[S.currentCaseIndex];
  if(!c.defendants) return;
  let allSet=true;
  for(let i=0;i<c.defendants.length;i++){
    if(S.ricoVerdicts[i]===undefined){allSet=false;break;}
  }
  if(!allSet){alert('Please render a verdict for every defendant.');return;}
  showRICOResult();
}

function showRICOResult(){
  const c=S.calendar[S.currentCaseIndex];
  let jd=0,td=0,sd=0,rd=0;
  let html=`<div class="card"><h3>📜 RICO Verdicts Delivered</h3>`;

  c.defendants.forEach((d,i)=>{
    const v=S.ricoVerdicts[i];
    const just=(v==='guilty'&&d.guilty)||(v==='not_guilty'&&!d.guilty);
    if(just){jd+=5;td+=2;rd+=3;sd+=800;}
    else if(v==='guilty'&&!d.guilty){jd-=8;td-=5;rd-=5;sd-=1200;}
    else{jd-=6;td-=3;rd-=4;sd-=800;}

    html+=`<div class="${just?'result-just':'result-unjust'}" style="text-align:left;margin-bottom:8px;">
      <strong>${d.name}</strong> — ${d.charge}: <strong>${v==='guilty'?'GUILTY':'NOT GUILTY'}</strong>
      ${just?'✓ Just':'✗ Unjust'}
    </div>`;

    if(v==='guilty'&&d.guilty){
      const sn=randItem(c.sentences);
      const prison = assignPrison(sn.years, false);
      S.inmates.push({
        name:d.name,charge:d.charge,sentence:sn.years,sentenceDay:S.day,
        behavior:randInt(30,90),remorse:randInt(20,80),timeServed:0,eligible:false,id:randInt(1000,9999),
        status:"Incarcerated",facility:prison,releaseDate:null,
        disciplinary:[],capital:false
      });
    }
  });

  html+=`</div>`;

  const postHeadline=generateMediaHeadline(c,true,'mixed');
  S.mediaHeadlines.push(postHeadline);
  S.mediaPressure=Math.max(0,S.mediaPressure-10);

  S.justice=Math.max(0,Math.min(100,S.justice+jd));
  S.publicTrust=Math.max(0,Math.min(100,S.publicTrust+td));
  S.reputation=Math.max(0,Math.min(100,S.reputation+rd));
  S.salary=Math.max(40000,S.salary+sd);
  S.xp+=jd>0?50:20;
  S.casesCompleted++;
  S.day++;
  S.currentCaseIndex++;

  html+=`<div class="stat-grid">
    <div class="stat-box"><div style="color:#666;">Justice</div><div class="num" style="color:${jd>=0?'#1b5e20':'#b71c1c'}">${jd>0?'+':''}${jd}</div></div>
    <div class="stat-box"><div style="color:#666;">Public Trust</div><div class="num" style="color:${td>=0?'#1b5e20':'#b71c1c'}">${td>0?'+':''}${td}</div></div>
    <div class="stat-box"><div style="color:#666;">Reputation</div><div class="num" style="color:${rd>=0?'#1b5e20':'#b71c1c'}">${rd>0?'+':''}${rd}</div></div>
    <div class="stat-box"><div style="color:#666;">Salary</div><div class="num" style="color:${sd>=0?'#1b5e20':'#b71c1c'}">${sd>0?'+':''}$${sd.toLocaleString()}</div></div>
  </div>`;
  html+=`<div style="text-align:center;margin-top:14px;"><button class="btn btn-navy" onclick="drawHub()">Return to Chambers</button></div>`;

  setMain(html);
  updateStats();
  renderCalendar();
  renderMedia();
}

// ==================== RESULT ====================
function showResult(){
  const c=S.calendar[S.currentCaseIndex];
  const isG=S.verdict==='guilty';
  const act=c.guilty;
  let jd=0,td=0,sd=0,rd=0,cls,title,txt;

  if(isG&&act){
    cls='result-just'; title='⚖️ Just Verdict';
    txt=`Evidence supported conviction. ${c.defendant} committed the crime.`;
    jd=8; td=5; rd=5; sd=1200;
  }else if(!isG&&!act){
    cls='result-just'; title='⚖️ Just Verdict';
    txt=`Evidence did not support conviction. ${c.defendant} was wrongfully accused.`;
    jd=10; td=3; rd=6; sd=1500;
  }else if(isG&&!act){
    cls='result-unjust'; title='❌ Wrongful Conviction';
    txt=`${c.defendant} was innocent. The evidence was misleading. A grave injustice.`;
    jd=-12; td=-8; rd=-8; sd=-2000;
  }else{
    cls='result-unjust'; title='❌ Guilty Walks Free';
    txt=`${c.defendant} was guilty but acquitted. Justice was not served.`;
    jd=-10; td=-5; rd=-6; sd=-1500;
  }

  let sentenceLabel='';
  if(isG&&act&&S.sentence!==null){
    const sn=c.sentences[S.sentence];
    jd+=sn.jus; td+=sn.pub;
    sentenceLabel=sn.label;
    txt+=`<br><br><strong>Sentence:</strong> ${sn.label}`;
    if(sn.years>0){
      const prison = assignPrison(sn.years, c.capital);
      S.inmates.push({
        name:c.defendant,charge:c.charge,sentence:sn.years,sentenceDay:S.day,
        behavior:randInt(30,90),remorse:randInt(20,80),timeServed:0,eligible:false,id:randInt(1000,9999),
        status:c.capital?"Death Row":"Incarcerated",facility:prison,releaseDate:null,
        disciplinary:[],capital:c.capital||false
      });
    }
  }

  if(c.capital&&isG&&act&&S.sentence!==null){
    const opts=["Death Penalty","Life Without Parole","Life With Parole","30 Years"];
    sentenceLabel=opts[S.sentence];
    txt+=`<br><br><strong>Sentence:</strong> ${sentenceLabel}`;
  }

  const pressureMult=1+(S.mediaPressure/200);
  if(jd<0){jd=Math.round(jd*pressureMult);td=Math.round(td*pressureMult);}
  else{jd=Math.round(jd/pressureMult);}

  const postHeadline=generateMediaHeadline(c,true,S.verdict,sentenceLabel);
  S.mediaHeadlines.push(postHeadline);
  S.mediaPressure=Math.max(0,S.mediaPressure-10);

  S.justice=Math.max(0,Math.min(100,S.justice+jd));
  S.publicTrust=Math.max(0,Math.min(100,S.publicTrust+td));
  S.reputation=Math.max(0,Math.min(100,S.reputation+rd));
  S.salary=Math.max(40000,S.salary+sd);
  S.xp+=(isG&&act)||(!isG&&!act)?randInt(40,70):randInt(10,30);
  S.casesCompleted++;
  S.day++;
  S.currentCaseIndex++;

  let html=`<div class="card"><h3>📜 Case Closed</h3>
    <div class="${cls}">
      <div style="font-size:1.1rem;margin-bottom:6px;">${title}</div>
      <div style="font-size:0.9rem;">${txt}</div>
    </div>
    <div class="stat-grid">
      <div class="stat-box"><div style="color:#666;">Justice</div><div class="num" style="color:${jd>=0?'#1b5e20':'#b71c1c'}">${jd>0?'+':''}${jd}</div></div>
      <div class="stat-box"><div style="color:#666;">Public Trust</div><div class="num" style="color:${td>=0?'#1b5e20':'#b71c1c'}">${td>0?'+':''}${td}</div></div>
      <div class="stat-box"><div style="color:#666;">Reputation</div><div class="num" style="color:${rd>=0?'#1b5e20':'#b71c1c'}">${rd>0?'+':''}${rd}</div></div>
      <div class="stat-box"><div style="color:#666;">Salary</div><div class="num" style="color:${sd>=0?'#1b5e20':'#b71c1c'}">${sd>0?'+':''}$${sd.toLocaleString()}</div></div>
    </div>
    <div style="text-align:center;margin-top:14px;">
      <button class="btn btn-navy" onclick="drawHub()">Return to Chambers</button>
    </div>
  </div>`;
  setMain(html);
  updateStats();
  renderCalendar();
  renderMedia();
}


// ==================== PAROLE SYSTEM ====================
function getEligibleInmates(){
  return S.inmates.filter(imm=>{
    if(imm.status!=="Incarcerated"&&imm.status!=="Segregation") return false;
    const servedPct=imm.timeServed/Math.max(1,imm.sentence*365);
    return servedPct>=0.5 && !imm.eligible && imm.sentence>0.5 && !imm.capital;
  });
}

function checkParole(){
  const eligible=getEligibleInmates();
  if(!eligible.length){
    setMain(`<div class="card"><h3>🔓 Parole Board</h3>
      <p>No inmates are currently eligible for parole review.</p>
      <p>Inmates become eligible after serving 50% of their sentence with good behavior.</p>
      <button class="btn btn-navy" onclick="drawHub()">Back</button>
    </div>`);
    return;
  }
  showParole(eligible[0]);
}

function showParole(inmate){
  S.currentParoleInmate=inmate;
  const servedPct=Math.round((inmate.timeServed/Math.max(1,inmate.sentence*365))*100);
  const discCount=inmate.disciplinary.length;
  const discSevere=inmate.disciplinary.filter(d=>d.severity>=3).length;
  const rec=inmate.behavior>70&&imm.remorse>50&&discSevere===0?"GRANT":"DENY";

  let html=`<div class="parole-card"><h3>🔓 Parole Hearing</h3>
    <div class="parole-stat"><strong>Inmate:</strong> <span>${inmate.name}</span></div>
    <div class="parole-stat"><strong>ID:</strong> <span>#${inmate.id}</span></div>
    <div class="parole-stat"><strong>Charge:</strong> <span>${inmate.charge}</span></div>
    <div class="parole-stat"><strong>Facility:</strong> <span><span class="facility-tag ${getFacilityClass(inmate.facility.level)}">${inmate.facility.name}</span> (${inmate.facility.level})</span></div>
    <div class="parole-stat"><strong>Sentence:</strong> <span>${inmate.sentence>=99?'Life':inmate.sentence+' Years'}</span></div>
    <div class="parole-stat"><strong>Time Served:</strong> <span>${inmate.timeServed} days (${servedPct}%)</span></div>
    <div class="parole-stat"><strong>Behavior Score:</strong> <span>${inmate.behavior}/100</span></div>
    <div class="parole-stat"><strong>Remorse Score:</strong> <span>${inmate.remorse}/100</span></div>
    <div class="parole-stat"><strong>Disciplinary Record:</strong> <span>${discCount} infractions${discSevere>0?' ('+discSevere+' severe)':''}</span></div>
    <div class="parole-stat"><strong>Board Recommendation:</strong> <span style="color:${rec==='GRANT'?'#1b5e20':'#b71c1c'};font-weight:bold;">${rec}</span></div>
  </div>`;

  html+=`<div class="card"><h4>📋 Institutional Report</h4>
    <p style="font-size:0.85rem;color:#444;">${inmate.name} has ${inmate.behavior>70?'maintained excellent conduct':'had several disciplinary incidents'} while incarcerated at ${inmate.facility.name}. 
    ${inmate.remorse>50?'Psychological evaluations indicate genuine remorse and rehabilitation.':'The inmate shows limited remorse for their crimes.'}
    ${discCount>0?'Disciplinary record includes '+discCount+' incident(s).':'Clean disciplinary record.'}</p>`;

  if(inmate.disciplinary.length){
    html+=`<div class="disciplinary-log"><strong>Disciplinary Log:</strong>`;
    inmate.disciplinary.slice(-5).forEach(d=>{
      html+=`<div class="disciplinary-entry ${d.severity>=3?'disc-severe':'disc-minor'}">Day ${d.day}: ${d.type} (${d.impact>0?'+':''}${d.impact} behavior)</div>`;
    });
    html+=`</div>`;
  }

  html+=`<div style="text-align:center;margin-top:12px;">
      <button class="btn btn-green" onclick="doParole('grant')">Grant Parole</button>
      <button class="btn btn-red" onclick="doParole('deny')">Deny Parole</button>
    </div>
  </div>`;

  setMain(html);
}

function doParole(decision){
  const imm=S.currentParoleInmate;
  if(!imm)return;
  imm.eligible=true;

  const discSevere=imm.disciplinary.filter(d=>d.severity>=3).length;
  const goodCandidate=imm.behavior>70&&imm.remorse>50&&discSevere===0;
  let jd=0,td=0,rd=0,sd=0,cls,title,txt;

  if(decision==='grant'&&goodCandidate){
    cls='result-just'; title='✅ Parole Granted';
    txt=`${imm.name} has demonstrated rehabilitation. Release from ${imm.facility.name} is appropriate.`;
    jd=5; td=3; rd=4; sd=500;
    imm.status="Paroled";
    imm.releaseDate=S.day;
  }else if(decision==='deny'&&!goodCandidate){
    cls='result-just'; title='🚫 Parole Denied';
    txt=`${imm.name} has not yet demonstrated sufficient rehabilitation at ${imm.facility.name}. Denial is in the interest of public safety.`;
    jd=3; td=2; rd=3; sd=300;
  }else if(decision==='grant'&&!goodCandidate){
    cls='result-unjust'; title='⚠️ Risky Release';
    txt=`${imm.name} was granted parole despite concerning behavior reports from ${imm.facility.name}. Public safety may be compromised.`;
    jd=-5; td=-6; rd=-4; sd=-800;
    imm.status="Paroled";
    imm.releaseDate=S.day;
  }else{
    cls='result-unjust'; title='❌ Excessive Denial';
    txt=`${imm.name} was denied parole despite clear evidence of rehabilitation. Justice delayed.`;
    jd=-3; td=-4; rd=-2; sd=-400;
  }

  S.justice=Math.max(0,Math.min(100,S.justice+jd));
  S.publicTrust=Math.max(0,Math.min(100,S.publicTrust+td));
  S.reputation=Math.max(0,Math.min(100,S.reputation+rd));
  S.salary=Math.max(40000,S.salary+sd);
  S.xp+=goodCandidate?30:15;

  let html=`<div class="card"><h3>📜 Parole Decision</h3>
    <div class="${cls}">
      <div style="font-size:1.1rem;margin-bottom:6px;">${title}</div>
      <div style="font-size:0.9rem;">${txt}</div>
    </div>
    <div class="stat-grid">
      <div class="stat-box"><div style="color:#666;">Justice</div><div class="num" style="color:${jd>=0?'#1b5e20':'#b71c1c'}">${jd>0?'+':''}${jd}</div></div>
      <div class="stat-box"><div style="color:#666;">Public Trust</div><div class="num" style="color:${td>=0?'#1b5e20':'#b71c1c'}">${td>0?'+':''}${td}</div></div>
      <div class="stat-box"><div style="color:#666;">Reputation</div><div class="num" style="color:${rd>=0?'#1b5e20':'#b71c1c'}">${rd>0?'+':''}${rd}</div></div>
      <div class="stat-box"><div style="color:#666;">Salary</div><div class="num" style="color:${sd>=0?'#1b5e20':'#b71c1c'}">${sd>0?'+':''}$${sd.toLocaleString()}</div></div>
    </div>
    <div style="text-align:center;margin-top:14px;">
      <button class="btn btn-navy" onclick="drawHub()">Return to Chambers</button>
    </div>
  </div>`;
  setMain(html);
  updateStats();
}

// ==================== ROSTER ====================
function showRoster(){
  let html=`<div class="card"><h3>📋 Inmate Roster</h3>`;

  html+=`<div class="filter-bar">
    <span style="font-size:0.8rem;color:#555;align-self:center;">Filter:</span>
    <button class="filter-btn ${ROSTER_FILTER==='all'?'active':''}" onclick="setRosterFilter('all')">All</button>
    <button class="filter-btn ${ROSTER_FILTER==='active'?'active':''}" onclick="setRosterFilter('active')">Active</button>
    <button class="filter-btn ${ROSTER_FILTER==='paroled'?'active':''}" onclick="setRosterFilter('paroled')">Paroled</button>
    <button class="filter-btn ${ROSTER_FILTER==='segregation'?'active':''}" onclick="setRosterFilter('segregation')">Segregation</button>
    <button class="filter-btn ${ROSTER_FILTER==='deathrow'?'active':''}" onclick="setRosterFilter('deathrow')">Death Row</button>
  </div>`;

  html+=`<div class="sort-bar">
    <span style="font-size:0.8rem;color:#555;">Sort by:</span>
    <select onchange="setRosterSort(this.value)">
      <option value="name" ${ROSTER_SORT==='name'?'selected':''}>Name</option>
      <option value="facility" ${ROSTER_SORT==='facility'?'selected':''}>Facility</option>
      <option value="sentence" ${ROSTER_SORT==='sentence'?'selected':''}>Sentence Length</option>
      <option value="served" ${ROSTER_SORT==='served'?'selected':''}>Time Served</option>
      <option value="behavior" ${ROSTER_SORT==='behavior'?'selected':''}>Behavior</option>
      <option value="release" ${ROSTER_SORT==='release'?'selected':''}>Release Date</option>
    </select>
  </div>`;

  let displayInmates = [...S.inmates];

  if(ROSTER_FILTER==='active') displayInmates = displayInmates.filter(i=>i.status==="Incarcerated");
  else if(ROSTER_FILTER==='paroled') displayInmates = displayInmates.filter(i=>i.status==="Paroled");
  else if(ROSTER_FILTER==='segregation') displayInmates = displayInmates.filter(i=>i.status==="Segregation");
  else if(ROSTER_FILTER==='deathrow') displayInmates = displayInmates.filter(i=>i.status==="Death Row");

  displayInmates.sort((a,b)=>{
    if(ROSTER_SORT==='name') return a.name.localeCompare(b.name);
    if(ROSTER_SORT==='facility') return a.facility.name.localeCompare(b.facility.name);
    if(ROSTER_SORT==='sentence') return b.sentence-a.sentence;
    if(ROSTER_SORT==='served') return b.timeServed-a.timeServed;
    if(ROSTER_SORT==='behavior') return b.behavior-a.behavior;
    if(ROSTER_SORT==='release') return (a.releaseDate||99999)-(b.releaseDate||99999);
    return 0;
  });

  if(!displayInmates.length){
    html+=`<p>No inmates match the current filter.</p>`;
  }else{
    html+=`<table class="roster-table">
      <tr><th>Name</th><th>ID</th><th>Charge</th><th>Facility</th><th>Status</th><th>Sentence</th><th>Served</th><th>Release</th><th>Disc.</th><th>Action</th></tr>`;
    displayInmates.forEach(imm=>{
      const servedPct=Math.round((imm.timeServed/Math.max(1,imm.sentence*365))*100);
      const releaseStr = calculateReleaseDate(imm);
      html+=`<tr>
        <td>${imm.name}</td>
        <td>#${imm.id}</td>
        <td>${imm.charge}</td>
        <td><span class="facility-tag ${getFacilityClass(imm.facility.level)}">${imm.facility.name}</span></td>
        <td><span class="status-tag ${getStatusClass(imm.status)}">${imm.status}</span></td>
        <td>${imm.sentence>=99?'Life':imm.sentence+' Yrs'}</td>
        <td>${imm.timeServed}d (${servedPct}%)</td>
        <td>${releaseStr}</td>
        <td>${imm.disciplinary.length}</td>
        <td><button class="btn btn-navy" style="font-size:0.65rem;padding:3px 8px;" onclick="viewInmateDetail(${imm.id})">View</button></td>
      </tr>`;
    });
    html+=`</table>`;
  }
  html+=`<div style="text-align:center;margin-top:14px;"><button class="btn btn-navy" onclick="drawHub()">Back</button></div></div>`;
  setMain(html);
}

function setRosterFilter(f){ROSTER_FILTER=f;showRoster();}
function setRosterSort(s){ROSTER_SORT=s;showRoster();}

function viewInmateDetail(inmateId){
  const imm=S.inmates.find(i=>i.id===inmateId);
  if(!imm)return;
  const servedPct=Math.round((imm.timeServed/Math.max(1,imm.sentence*365))*100);
  const releaseStr=calculateReleaseDate(imm);

  let html=`<div class="card"><h3>📋 Inmate Detail — ${imm.name}</h3>`;
  html+=`<div class="inmate-detail">`;
  html+=`<div class="inmate-detail-row"><span><strong>Inmate ID</strong></span><span>#${imm.id}</span></div>`;
  html+=`<div class="inmate-detail-row"><span><strong>Charge</strong></span><span>${imm.charge}</span></div>`;
  html+=`<div class="inmate-detail-row"><span><strong>Facility</strong></span><span><span class="facility-tag ${getFacilityClass(imm.facility.level)}">${imm.facility.name}</span> (${imm.facility.level})</span></div>`;
  html+=`<div class="inmate-detail-row"><span><strong>Status</strong></span><span><span class="status-tag ${getStatusClass(imm.status)}">${imm.status}</span></span></div>`;
  html+=`<div class="inmate-detail-row"><span><strong>Sentence</strong></span><span>${imm.sentence>=99?'Life':imm.sentence+' Years'}</span></div>`;
  html+=`<div class="inmate-detail-row"><span><strong>Time Served</strong></span><span>${imm.timeServed} days (${servedPct}%)</span></div>`;
  html+=`<div class="inmate-detail-row"><span><strong>Projected Release</strong></span><span>${releaseStr}</span></div>`;
  html+=`<div class="inmate-detail-row"><span><strong>Behavior Score</strong></span><span>${imm.behavior}/100</span></div>`;
  html+=`<div class="inmate-detail-row"><span><strong>Remorse Score</strong></span><span>${imm.remorse}/100</span></div>`;
  html+=`<div class="inmate-detail-row"><span><strong>Capital Case</strong></span><span>${imm.capital?'Yes':'No'}</span></div>`;
  html+=`</div>`;

  if(imm.disciplinary.length){
    html+=`<div class="disciplinary-log"><strong>Disciplinary Record (${imm.disciplinary.length} entries):</strong>`;
    imm.disciplinary.forEach(d=>{
      html+=`<div class="disciplinary-entry ${d.severity>=3?'disc-severe':d.severity>=2?'disc-minor':''}">Day ${d.day}: ${d.type} <em>(${d.impact>0?'+':''}${d.impact} behavior)</em></div>`;
    });
    html+=`</div>`;
  }else{
    html+=`<div class="card" style="background:#e8f5e9;border-color:#1b5e20;"><em>Clean disciplinary record.</em></div>`;
  }

  if(imm.status==="Incarcerated"||imm.status==="Segregation"){
    html+=`<div style="text-align:center;margin-top:12px;">
      <button class="btn btn-orange" onclick="transferInmate(${imm.id})">Transfer Facility</button>
      <button class="btn btn-red" onclick="placeInSegregation(${imm.id})">Segregation</button>
    </div>`;
  }

  html+=`<div style="text-align:center;margin-top:14px;"><button class="btn btn-navy" onclick="showRoster()">Back to Roster</button></div></div>`;
  setMain(html);
}

function transferInmate(inmateId){
  const imm=S.inmates.find(i=>i.id===inmateId);
  if(!imm)return;
  const newPrison = assignPrison(imm.sentence, imm.capital);
  imm.facility = newPrison;
  alert(`Inmate ${imm.name} transferred to ${newPrison.name} (${newPrison.level}).`);
  viewInmateDetail(inmateId);
}

function placeInSegregation(inmateId){
  const imm=S.inmates.find(i=>i.id===inmateId);
  if(!imm)return;
  if(imm.status==="Segregation"){
    imm.status="Incarcerated";
    alert(`${imm.name} returned to general population.`);
  }else{
    imm.status="Segregation";
    imm.behavior=Math.max(0,imm.behavior-10);
    alert(`${imm.name} placed in segregation. Behavior score decreased.`);
  }
  viewInmateDetail(inmateId);
}


// ==================== DAY ADVANCE ====================
function advanceDay(){
  S.day++;

  // Age inmates and generate disciplinary actions
  S.inmates.forEach(imm=>{
    if(imm.status==="Incarcerated"||imm.status==="Segregation"){
      imm.timeServed++;

      // Random behavior changes
      if(Math.random()<0.3) imm.behavior=Math.max(0,Math.min(100,imm.behavior+randInt(-5,5)));
      if(Math.random()<0.2) imm.remorse=Math.max(0,Math.min(100,imm.remorse+randInt(-3,3)));

      // Random disciplinary actions based on behavior and facility security
      const discChance = imm.behavior < 40 ? 0.25 : imm.behavior < 70 ? 0.12 : 0.05;
      const securityMult = imm.facility.security / 4;
      if(Math.random() < discChance * securityMult){
        const action = generateDisciplinaryAction();
        imm.disciplinary.push(action);
        imm.behavior = Math.max(0, imm.behavior + action.impact);
        // Severe infractions may trigger segregation
        if(action.severity>=3 && imm.status==="Incarcerated"){
          imm.status="Segregation";
        }
      }

      // Check for natural release (sentence completed)
      if(imm.sentence<99 && imm.timeServed>=imm.sentence*365){
        if(imm.status!=="Paroled" && imm.status!=="Released"){
          imm.status="Released";
          imm.releaseDate=S.day;
        }
      }
    }
  });

  // Random media decay
  S.mediaPressure=Math.max(0,S.mediaPressure-randInt(3,8));

  // Salary adjustment based on rank
  const rank=getRank();
  if(S.salary<RANKS[rank].salaryBase) S.salary+=500;

  updateStats();
  renderCalendar();
  renderMedia();

  // Check for promotion
  const newRank=getRank();
  if(newRank>rank){
    setMain(`<div class="start-screen">
      <h2>🎖️ Promotion!</h2>
      <div style="font-size:1.2rem;color:#b8860b;margin-bottom:10px;">${RANKS[newRank].title}</div>
      <p>You have been promoted! New salary baseline: $${RANKS[newRank].salaryBase.toLocaleString()}.</p>
      <p><strong>Unlocked:</strong> ${RANKS[newRank].unlock}</p>
      <button class="btn btn-navy" onclick="drawHub()" style="margin-top:16px;">Continue</button>
    </div>`);
    S.salary=RANKS[newRank].salaryBase;
    updateStats();
  }else{
    drawHub();
  }
}

// ==================== END GAME ====================
function endGame(){
  const avg=(S.justice+S.publicTrust+S.reputation)/3;
  let title,summary;
  if(avg>=75){
    title="🏆 Legendary Jurist";
    summary=`Your career has been exemplary. Justice: ${S.justice}, Trust: ${S.publicTrust}. Final salary: $${S.salary.toLocaleString()}. You retire as ${getRankInfo().title}.`;
  }else if(avg>=50){
    title="⚖️ Solid Record";
    summary=`You served with competence. Justice: ${S.justice}, Trust: ${S.publicTrust}. Final salary: $${S.salary.toLocaleString()}. A respectable career.`;
  }else if(avg>=30){
    title="📉 Controversial Career";
    summary=`Your time was marked by inconsistency. Justice: ${S.justice}, Trust: ${S.publicTrust}. Final salary: $${S.salary.toLocaleString()}. History will debate your legacy.`;
  }else{
    title="⚠️ Disgraced";
    summary=`Your record is under serious scrutiny. Justice: ${S.justice}, Trust: ${S.publicTrust}. Final salary: $${S.salary.toLocaleString()}. The judicial conduct board has opened an inquiry.`;
  }

  setMain(`
    <div class="start-screen">
      <h2>🏛️ End of Career</h2>
      <div style="font-size:1.2rem;color:#3e2723;margin-bottom:10px;">${title}</div>
      <p>${summary}</p>
      <div class="end-grid">
        <div class="end-box"><div style="font-size:0.8rem;color:#555;">Justice</div><div class="num">${S.justice}</div></div>
        <div class="end-box"><div style="font-size:0.8rem;color:#555;">Trust</div><div class="num">${S.publicTrust}</div></div>
        <div class="end-box"><div style="font-size:0.8rem;color:#555;">Reputation</div><div class="num">${S.reputation}</div></div>
      </div>
      <div style="font-size:1.1rem;color:#b8860b;font-weight:bold;">Final Rank: ${getRankInfo().title}</div>
      <div style="font-size:1.1rem;color:#b8860b;font-weight:bold;margin-top:6px;">Final Salary: $${S.salary.toLocaleString()}</div>
      <button class="btn btn-navy" onclick="startGame()" style="margin-top:20px;font-size:1.05rem;padding:14px 32px;">Start New Career</button>
    </div>
  `);
  updateStats();
}

// Initialize
drawStart();
</script>
