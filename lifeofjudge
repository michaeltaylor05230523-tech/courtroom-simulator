  .status-seg { background: #ffebee; color: #b71c1c; }
  .status-par { background: #e8f5e9; color: #1b5e20; }
  .status-rel { background: #f5f5f5; color: #757575; }
  .status-dec { background: #3e2723; color: #ffd700; }
  .disciplinary-log {
