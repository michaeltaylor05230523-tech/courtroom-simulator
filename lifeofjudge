<style>
  * { box-sizing: border-box; }
  body {
    font-family: 'Georgia', 'Times New Roman', serif;
    background: #e8e0d5;
    margin: 0;
    padding: 20px;
    color: #2c1810;
  }
  .game-wrap {
    max-width: 960px;
    margin: 0 auto;
    background: #faf3e0;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 6px 24px rgba(0,0,0,0.35);
    border: 2px solid #5d4037;
  }
  .header {
    background: #3e2723;
    color: #ffd700;
    padding: 14px 20px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 3px solid #b8860b;
    flex-wrap: wrap;
    gap: 8px;
  }
  .header h1 { margin: 0; font-size: 1.3rem; letter-spacing: 1px; }
  .header .rank-badge {
    background: #b8860b;
    color: #3e2723;
    padding: 3px 10px;
    border-radius: 12px;
    font-size: 0.75rem;
    font-weight: bold;
  }
  .stats {
    display: flex;
    gap: 16px;
    font-size: 0.85rem;
    flex-wrap: wrap;
  }
  .stats span { font-weight: bold; color: #ffd700; }
  .main {
    display: grid;
    grid-template-columns: 240px 1fr;
    min-height: 560px;
  }
  .sidebar {
    background: #f5e6c8;
    padding: 14px;
    border-right: 2px solid #8d6e63;
    overflow-y: auto;
    max-height: 600px;
