let S = {};
let ROSTER_FILTER = 'all';
let ROSTER_SORT = 'name';

function randInt(min,max){return Math.floor(Math.random()*(max-min+1))+min;}
function randItem(arr){return arr[Math.floor(Math.random()*arr.length)];}
function randRange(min,max){return Math.random()*(max-min)+min;}
function randName(){return randItem(FIRST_NAMES)+" "+randItem(LAST_NAMES);}

function getRank(){
  for(let i=RANKS.length-1;i>=0;i--) if(S.xp>=RANKS[i].xpNeed) return i;
  return 0;
}

function getRankInfo(){return RANKS[getRank()];}

function nextRankXP(){
  const r=getRank();
  if(r>=RANKS.length-1) return 99999;
  return RANKS[r+1].xpNeed;
}

function assignPrison(years,capital){
  if(capital) return {name:"State Death Row Facility",level:"Death Row",security:5};
  if(years>=20) return randItem(PRISONS.filter(p=>p.security>=3));
  if(years>=5) return randItem(PRISONS.filter(p=>p.security===2||p.security===3));
  if(years>=1) return randItem(PRISONS.filter(p=>p.security>=1&&p.security<=2));
  return randItem(PRISONS.filter(p=>p.security===1));
}

function getFacilityClass(level){
  if(level==="Minimum") return "facility-min";
  if(level==="Medium") return "facility-med";
  if(level==="Maximum") return "facility-max";
  if(level==="Supermax") return "facility-super";
  return "facility-death";
}

function getStatusClass(status){
  if(status==="Incarcerated") return "status-inc";
  if(status==="Segregation") return "status-seg";
  if(status==="Paroled") return "status-par";
  if(status==="Released") return "status-rel";
  return "status-dec";
}

function calculateReleaseDate(imm){
  if(imm.sentence>=99) return "Life";
  if(imm.status==="Paroled"||imm.status==="Released") return "Completed";
  const daysRemaining = Math.max(0, Math.round(imm.sentence * 365) - imm.timeServed);
  if(daysRemaining<=0) return "Overdue";
  const releaseDay = S.day + daysRemaining;
  return "Day " + releaseDay + " (~" + Math.ceil(daysRemaining/365) + "y)";
}

function generateDisciplinaryAction(){
  const inf = randItem(DISCIPLINARY_INFRACTIONS);
  return {
    day: S.day,
    type: inf.type,
    severity: inf.severity,
    impact: inf.impact,
  };
}


// ==================== PROCEDURAL GENERATION ====================
function generateCase(forceType){
  const keys=Object.keys(CHARGE_TEMPLATES);
  let cat=randItem(keys);
  if(forceType) cat=forceType;
  const tmpl=CHARGE_TEMPLATES[cat];
  const chargeLabel=randItem(tmpl.labels);

  let evidence=[];
  for(const ev of tmpl.evidence){
    evidence.push({
      id:"e"+(evidence.length+1),
      name:ev.name,
      desc:ev.desc,
      weight:parseFloat(randRange(ev.weightRange[0],ev.weightRange[1]).toFixed(2))
    });
  }
  const totalWeight=evidence.reduce((a,b)=>a+b.weight,0);
  const guilty=totalWeight>0.4;

  let witnesses=[];
  for(const wit of tmpl.witnesses){
    witnesses.push({name:randName(),role:wit.role,text:wit.text});
  }

  let sentences=[];
  for(const s of tmpl.sentences) sentences.push({...s});

  const isCapital = (cat==="homicide" && chargeLabel==="First-Degree Murder" && getRank()>=2);

  return {
    id:"2026-"+randInt(100,999),
    charge:chargeLabel,
    defendant:randName(),
    pros:randItem(["State","Federal","DA's Office","Special Prosecutor"]),
    def:randItem(["Public Defender","Private Attorney","Defense Firm","Legal Aid"]),
    type:tmpl.type,
    guilty:guilty,
    capital:isCapital,
    rico:false,
    evidence:evidence,
    witnesses:witnesses,
    sentences:sentences,
    severity:tmpl.severity,
    mediaHeadline:"",
    defendants:null,
  };
}

function generateRICOCase(){
  const numDef=randInt(2,4);
  const defendants=[];
  for(let i=0;i<numDef;i++){
    const cat=randItem(["theft","fraud","drugs","homicide"]);
    const tmpl=CHARGE_TEMPLATES[cat];
    let devEvidence=[];
    for(const ev of tmpl.evidence.slice(0,3)){
      devEvidence.push({
        id:"d"+i+"e"+(devEvidence.length+1),
        name:ev.name,
        desc:ev.desc,
        weight:parseFloat(randRange(ev.weightRange[0],ev.weightRange[1]).toFixed(2))
      });
    }
    const totalWeight=devEvidence.reduce((a,b)=>a+b.weight,0);
    defendants.push({
      name:randName(),
      charge:randItem(tmpl.labels),
      guilty:totalWeight>0.3,
      evidence:devEvidence,
      witnesses:[
        {name:randName(),role:"Associate",text:"I saw them at the meetings. They knew what was going on."},
        {name:randName(),role:"Defendant",text:"I had no idea about the larger operation. I was just trying to survive."},
      ],
      verdict:null,
      sentence:null,
    });
  }

  const conspiracyEvidence=[
    {id:"ce1",name:"Wiretap Recordings",desc:"Multiple defendants heard discussing illegal operations.",weight:0.8},
    {id:"ce2",name:"Financial Ledgers",desc:"Shared account used to launder proceeds.",weight:0.7},
    {id:"ce3",name:"Organizational Chart",desc:"Document shows hierarchy and defendant roles.",weight:0.6},
    {id:"ce4",name:"Cooperating Witness",desc:"Former member testifies about conspiracy structure.",weight:0.5},
  ];

  return {
    id:"2026-RICO-"+randInt(10,99),
    charge:"Racketeering (RICO)",
    defendant:"Multiple Defendants",
    pros:"Federal RICO Task Force",
    def:"Consortium of Defense Attorneys",
    type:"jury",
    guilty:true,
    capital:false,
    rico:true,
    evidence:conspiracyEvidence,
    witnesses:[
      {name:randName(),role:"FBI Agent",text:"This organization operated for three years across state lines."},
      {name:randName(),role:"Cooperating Witness",text:"I was there from the start. Everyone at that table knew the deal."},
    ],
    sentences:[
      {label:"20 Years Federal",pub:5,jus:7,years:20},
      {label:"10 Years + Fine",pub:3,jus:5,years:10},
      {label:"5 Years + Probation",pub:0,jus:2,years:5},
      {label:"House Arrest",pub:-5,jus:-4,years:0},
    ],
    severity:8,
    mediaHeadline:"",
    defendants:defendants,
  };
}

function generateCapitalCase(){
  const c=generateCase("homicide");
  c.charge="Capital Murder";
  c.capital=true;
  c.severity=10;
  c.sentences=[
    {label:"Death Penalty",pub:10,jus:6,years:99},
    {label:"Life Without Parole",pub:5,jus:7,years:99},
    {label:"Life With Parole",pub:0,jus:3,years:99},
    {label:"30 Years",pub:-5,jus:-3,years:30},
  ];
  return c;
}

function generateMediaHeadline(caseObj,isPost,verdict,sentenceLabel){
  let h=randItem(MEDIA_PRE_HEADLINES);
  if(isPost){
    const just=(verdict==="guilty"&&caseObj.guilty)||(verdict==="not_guilty"&&!caseObj.guilty);
    h=randItem(just?MEDIA_POST_POSITIVE:MEDIA_POST_NEGATIVE);
  }
  h=h.replace(/{charge}/g,caseObj.charge).replace(/{defendant}/g,caseObj.defendant||"defendant");
  if(sentenceLabel) h+=" Sentence: "+sentenceLabel+".";
  return h;
}

