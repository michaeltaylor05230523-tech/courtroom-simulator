let S = {
  day: 1, salary: 85000, reputation: 50, justice: 50, publicTrust: 50,
  casesCompleted: 0, currentCaseIndex: 0, selectedEvidence: new Set(),
  currentWitnessIndex: 0, verdict: null, sentence: null, calendar: []
};

function shuffle(arr) {
  const a = [...arr];
  for (let i = a.length - 1; i > 0; i--) {
    const j = Math.floor(Math.random() * (i + 1));
    [a[i], a[j]] = [a[j], a[i]];
  }
  return a;
}

function updateStats() {
  document.getElementById('st-sal').textContent = '$' + S.salary.toLocaleString();
  const stars = Math.max(1, Math.min(5, Math.floor(S.reputation / 20)));
  document.getElementById('st-rep').textContent = '★'.repeat(stars) + '☆'.repeat(5 - stars);
  document.getElementById('st-day').textContent = S.day;
  document.getElementById('st-cas').textContent = S.casesCompleted;
  document.getElementById('st-jus').textContent = S.justice;
  document.getElementById('bar-jus').style.width = S.justice + '%';
  document.getElementById('st-tru').textContent = S.publicTrust;
  document.getElementById('bar-tru').style.width = S.publicTrust + '%';
}

function renderCalendar() {
  const list = document.getElementById('cal-list');
  let html = '';
  S.calendar.forEach((c, i) => {
    html += `<div class="cal-day ${i === S.currentCaseIndex ? 'active' : ''}">
      <div class="cal-title">${c.id}</div>
      <div class="cal-type">${c.charge} <span class="badge ${c.type === 'jury' ? 'badge-j' : 'badge-b'}">${c.type === 'jury' ? 'Jury' : 'Bench'}</span></div>
    </div>`;
  });
  list.innerHTML = html;
}

function setMain(html) {
  document.getElementById('main-content').innerHTML = html;
}

function drawStart() {
  setMain(`
    <div class="start-screen">
      <h2>Welcome to the Bench</h2>
      <p>You are a newly appointed judge in the State District Court. Every day brings new cases — some require a jury, others rest solely on your judgment. Weigh the evidence, hear the witnesses, and deliver justice. Your reputation and salary depend on it.</p>
      <button class="btn btn-navy" onclick="startGame()" style="font-size:1.1rem;padding:14px 32px;">Take the Oath & Begin</button>
    </div>
  `);
}

function startGame() {
  S = {
    day: 1, salary: 85000, reputation: 50, justice: 50, publicTrust: 50,
    casesCompleted: 0, currentCaseIndex: 0, selectedEvidence: new Set(),
    currentWitnessIndex: 0, verdict: null, sentence: null, calendar: shuffle([...CASES])
  };
  updateStats();
  renderCalendar();
  loadCase(0);
}

function loadCase(index) {
  if (index >= S.calendar.length) { endGame(); return; }
  S.currentCaseIndex = index;
  S.selectedEvidence.clear();
  S.currentWitnessIndex = 0;
  S.verdict = null;
  S.sentence = null;
  updateStats();
  renderCalendar();

  const c = S.calendar[index];
  let html = `<div class="card">
    <h3>Case #${c.id} <span class="badge ${c.type === 'jury' ? 'badge-j' : 'badge-b'}">${c.type === 'jury' ? 'Jury Trial' : 'Bench Trial'}</span></h3>
    <div class="meta">
      <strong>Charge:</strong> ${c.charge}<br>
      <strong>Defendant:</strong> ${c.defendant}<br>
      <strong>Prosecution:</strong> ${c.pros}<br>
      <strong>Defense:</strong> ${c.def}
    </div>`;

  if (c.type === 'jury') {
    let gv = 0;
    c.evidence.forEach(e => { if (e.weight > 0.3) gv++; else if (e.weight < -0.3) gv--; });
    gv = Math.max(3, Math.min(10, gv + 6));
    html += `<div class="jury-box">
      <h4>🧑‍⚖️ Jury Deliberation</h4>
      <div class="jury-row">
        <span>Guilty Votes: <span style="color:#ef5350;font-weight:bold;">${gv}</span>/12</span>
        <span>Innocent Votes: <span style="color:#66bb6a;font-weight:bold;">${12 - gv}</span>/12</span>
      </div>
    </div>`;
  }
  html += `</div>`;

  html += `<div class="card"><h3>📁 Evidence <span style="font-size:0.8rem;color:#666;font-weight:normal;">(click to read details)</span></h3>`;
  c.evidence.forEach((e, idx) => {
    html += `<div class="evidence-item" onclick="toggleEvidence(${idx})" id="ev-tag-${idx}">${e.name}</div>
             <div class="evidence-desc" id="ev-desc-${idx}">${e.desc}</div>`;
  });
  html += `</div>`;

  html += `<div class="card"><h3>🎤 Witness Testimony</h3><div id="wit-box"></div>
    <button class="btn btn-wood" onclick="nextWitness()">Next Witness</button>
  </div>`;

  html += `<div style="margin-top:8px;">
    <button class="btn btn-green" onclick="doVerdict('guilty')">⚖️ Guilty</button>
    <button class="btn btn-red" onclick="doVerdict('not_guilty')">✋ Not Guilty</button>
  </div>`;

  setMain(html);
  drawWitnesses();
}

function toggleEvidence(idx) {
  const tag = document.getElementById('ev-tag-' + idx);
  const desc = document.getElementById('ev-desc-' + idx);
  const e = S.calendar[S.currentCaseIndex].evidence[idx];
  tag.classList.toggle('selected');
  desc.classList.toggle('open');
  if (S.selectedEvidence.has(e.id)) S.selectedEvidence.delete(e.id);
  else S.selectedEvidence.add(e.id);
}

function drawWitnesses() {
  const c = S.calendar[S.currentCaseIndex];
  const box = document.getElementById('wit-box');
  if (!box) return;
  let html = '';
  for (let i = 0; i <= S.currentWitnessIndex && i < c.witnesses.length; i++) {
    const w = c.witnesses[i];
    html += `<div class="witness">
      <div class="witness-name">${w.name}</div>
      <div class="witness-role">${w.role}</div>
      <div class="witness-text">"${w.text}"</div>
    </div>`;
  }
  box.innerHTML = html;
}

function nextWitness() {
  const c = S.calendar[S.currentCaseIndex];
  if (S.currentWitnessIndex < c.witnesses.length - 1) {
    S.currentWitnessIndex++;
    drawWitnesses();
  }
}

function doVerdict(v) {
  S.verdict = v;
  const c = S.calendar[S.currentCaseIndex];
  if (v === 'not_guilty') { showResult(); return; }

  let html = `<div class="card"><h3>⚖️ Sentencing</h3>
    <p><strong>${c.defendant}</strong> has been found <strong style="color:#b71c1c;">GUILTY</strong> of <strong>${c.charge}</strong>.</p>
    <p>The court now proceeds to sentencing. Consider the severity of the crime, the defendant's background, public safety, and the interests of justice.</p>
    <div style="background:#f5e6c8;border:2px solid #b8860b;border-radius:8px;padding:16px;text-align:center;margin-top:12px;">
      <div style="font-weight:bold;color:#3e2723;margin-bottom:10px;">Select Sentence</div>`;
  c.sentences.forEach((s, i) => {
    html += `<button class="sentence-btn" onclick="selectSentence(${i})" id="snt-${i}">${s.label}</button>`;
  });
  html += `</div>
    <div style="text-align:center;margin-top:14px;">
      <button class="btn btn-navy" onclick="confirmSentence()">Deliver Sentence</button>
    </div>
  </div>`;
  setMain(html);
  S.sentence = null;
}

function selectSentence(i) {
  S.sentence = i;
  document.querySelectorAll('.sentence-btn').forEach(b => b.classList.remove('selected'));
  document.getElementById('snt-' + i).classList.add('selected');
}

function confirmSentence() {
  if (S.sentence === null) {
    alert('Please select a sentence first.');
    return;
  }
  showResult();
}

function showResult() {
  const c = S.calendar[S.currentCaseIndex];
  const isG = S.verdict === 'guilty';
  const act = c.guilty;
  let jd = 0, td = 0, sd = 0, rd = 0, cls, title, txt;

  if (isG && act) {
    cls = 'result-just'; title = '⚖️ Just Verdict';
    txt = `The evidence supported conviction. ${c.defendant} committed the crime as charged.`;
    jd = 8; td = 5; rd = 5; sd = 1200;
  } else if (!isG && !act) {
    cls = 'result-just'; title = '⚖️ Just Verdict';
    txt = `The evidence did not support conviction. ${c.defendant} was wrongfully accused.`;
    jd = 10; td = 3; rd = 6; sd = 1500;
  } else if (isG && !act) {
    cls = 'result-unjust'; title = '❌ Wrongful Conviction';
    txt = `${c.defendant} was innocent. The evidence was misleading or insufficient. A grave injustice.`;
    jd = -12; td = -8; rd = -8; sd = -2000;
  } else {
    cls = 'result-unjust'; title = '❌ Guilty Walks Free';
    txt = `${c.defendant} was guilty but acquitted. The evidence was there — justice was not served.`;
    jd = -10; td = -5; rd = -6; sd = -1500;
  }

  if (isG && act && S.sentence !== null) {
    const sn = c.sentences[S.sentence];
    jd += sn.jus; td += sn.pub;
    txt += `<br><br><strong>Sentence:</strong> ${sn.label}`;
  }

  S.justice = Math.max(0, Math.min(100, S.justice + jd));
  S.publicTrust = Math.max(0, Math.min(100, S.publicTrust + td));
  S.reputation = Math.max(0, Math.min(100, S.reputation + rd));
  S.salary = Math.max(40000, S.salary + sd);
  S.casesCompleted++;
  S.day++;

  let html = `<div class="card"><h3>📜 Case Closed</h3>
    <div class="${cls}">
      <div style="font-size:1.2rem;margin-bottom:6px;">${title}</div>
      <div style="font-size:0.95rem;">${txt}</div>
    </div>
    <div class="stat-grid">
      <div class="stat-box"><div style="color:#666;">Justice</div><div class="num" style="color:${jd >= 0 ? '#1b5e20' : '#b71c1c'}">${jd > 0 ? '+' : ''}${jd}</div></div>
      <div class="stat-box"><div style="color:#666;">Public Trust</div><div class="num" style="color:${td >= 0 ? '#1b5e20' : '#b71c1c'}">${td > 0 ? '+' : ''}${td}</div></div>
      <div class="stat-box"><div style="color:#666;">Reputation</div><div class="num" style="color:${rd >= 0 ? '#1b5e20' : '#b71c1c'}">${rd > 0 ? '+' : ''}${rd}</div></div>
      <div class="stat-box"><div style="color:#666;">Salary</div><div class="num" style="color:${sd >= 0 ? '#1b5e20' : '#b71c1c'}">${sd > 0 ? '+' : ''}$${sd.toLocaleString()}</div></div>
    </div>
    <div style="text-align:center;margin-top:16px;">
      <button class="btn btn-navy" onclick="loadCase(${S.currentCaseIndex + 1})">Next Case on Docket</button>
    </div>
  </div>`;
  setMain(html);
  updateStats();
}

function endGame() {
  const avg = (S.justice + S.publicTrust + S.reputation) / 3;
  let title, summary;
  if (avg >= 75) {
    title = "🏆 Legendary Jurist";
    summary = `Your term has been exemplary. Justice: ${S.justice}, Trust: ${S.publicTrust}. Final salary: $${S.salary.toLocaleString()}. The bar association has nominated you for the appellate court.`;
  } else if (avg >= 50) {
    title = "⚖️ Solid Record";
    summary = `You served with competence. Justice: ${S.justice}, Trust: ${S.publicTrust}. Final salary: $${S.salary.toLocaleString()}. A respectable tenure.`;
  } else if (avg >= 30) {
    title = "📉 Controversial Tenure";
    summary = `Your time was marked by inconsistency. Justice: ${S.justice}, Trust: ${S.publicTrust}. Final salary: $${S.salary.toLocaleString()}. The electorate is watching closely.`;
  } else {
    title = "⚠️ Impeachment Risk";
    summary = `Your record is under serious scrutiny. Justice: ${S.justice}, Trust: ${S.publicTrust}. Final salary: $${S.salary.toLocaleString()}. The judicial conduct board has opened an inquiry.`;
  }

  setMain(`
    <div class="start-screen">
      <h2>🏛️ End of Term</h2>
      <div style="font-size:1.2rem;color:#3e2723;margin-bottom:10px;">${title}</div>
      <p>${summary}</p>
      <div class="end-grid">
        <div class="end-box"><div style="font-size:0.8rem;color:#555;">Justice</div><div class="num">${S.justice}</div></div>
        <div class="end-box"><div style="font-size:0.8rem;color:#555;">Trust</div><div class="num">${S.publicTrust}</div></div>
        <div class="end-box"><div style="font-size:0.8rem;color:#555;">Reputation</div><div class="num">${S.reputation}</div></div>
      </div>
      <div style="font-size:1.1rem;color:#b8860b;font-weight:bold;">Final Salary: $${S.salary.toLocaleString()}</div>
      <button class="btn btn-navy" onclick="startGame()" style="margin-top:20px;font-size:1.05rem;padding:14px 32px;">Start New Term</button>
    </div>
  `);
  updateStats();
}

// Initialize
drawStart();
</script>
</body>
</html>
