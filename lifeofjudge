    color: #3e2723;
    border-bottom: 1px solid #8d6e63;
    padding-bottom: 4px;
  }
  .cal-day {
    background: #fff;
    border: 1px solid #8d6e63;
    border-radius: 6px;
    padding: 6px;
    margin-bottom: 6px;
    font-size: 0.75rem;
  }
  .cal-day.active {
    border-color: #b8860b;
    background: #fff8e1;
    box-shadow: 0 0 0 2px #b8860b;
  }
  .cal-title { font-weight: bold; color: #1a237e; }
  .cal-type { font-size: 0.7rem; color: #424242; }
  .badge {
    display: inline-block;
    padding: 1px 5px;
    border-radius: 4px;
    font-size: 0.65rem;
    font-weight: bold;
    margin-left: 3px;
  }
  .badge-j { background: #e3f2fd; color: #1a237e; }
  .badge-b { background: #f3e5f5; color: #4a148c; }
  .badge-c { background: #ffebee; color: #b71c1c; }
  .badge-r { background: #e8f5e9; color: #1b5e20; }
  .badge-d { background: #fff3e0; color: #e65100; }
  .content { padding: 16px; background: #faf3e0; overflow-y: auto; max-height: 600px; }
  .card {
    background: #fff;
    border: 2px solid #8d6e63;
    border-radius: 8px;
    padding: 14px;
    margin-bottom: 12px;
  }
  .card h3 { margin: 0 0 8px 0; color: #3e2723; font-size: 1rem; }
  .meta {
    background: #f5f5f5;
    border-radius: 6px;
    padding: 10px;
    font-size: 0.85rem;
    line-height: 1.5;
  }
  .meta strong { color: #3e2723; }
  .evidence-item {
    display: inline-block;
    background: #f5e6c8;
    border: 1px solid #8d6e63;
    border-radius: 4px;
    padding: 4px 10px;
    margin: 3px 3px 0 0;
    font-size: 0.8rem;
    cursor: pointer;
    user-select: none;
    transition: all 0.15s;
  }
  .evidence-item:hover { background: #fff8e1; }
  .evidence-item.selected {
    background: #1a237e;
    color: #fff;
    border-color: #1a237e;
  }
  .evidence-desc {
    display: none;
    background: #f5f5f5;
    border-left: 3px solid #1a237e;
    padding: 8px;
    margin: 6px 0;
    border-radius: 0 6px 6px 0;
    font-size: 0.8rem;
    color: #333;
  }
  .evidence-desc.open { display: block; }
  .witness {
    background: #f5e6c8;
    border-left: 4px solid #5d4037;
    border-radius: 6px;
    padding: 10px;
    margin-bottom: 8px;
  }
  .witness-name { font-weight: bold; color: #3e2723; font-size: 0.9rem; }
  .witness-role { font-size: 0.75rem; color: #555; }
  .witness-text { font-style: italic; font-size: 0.85rem; color: #444; margin-top: 4px; }
  .jury-box {
    background: #3e2723;
    color: #faf3e0;
    border-radius: 8px;
    padding: 10px;
    margin-top: 10px;
  }
  .jury-box h4 { margin: 0 0 6px 0; color: #ffd700; font-size: 0.85rem; }
  .jury-row { display: flex; justify-content: space-between; font-size: 0.8rem; }
  .btn {
    padding: 8px 16px;
    border: none;
    border-radius: 6px;
    font-family: Georgia, serif;
    font-size: 0.85rem;
    cursor: pointer;
    font-weight: bold;
    margin: 3px;
    transition: all 0.2s;
  }
  .btn:hover { transform: translateY(-1px); opacity: 0.92; }
  .btn-navy { background: #1a237e; color: #fff; }
  .btn-green { background: #1b5e20; color: #fff; }
  .btn-red { background: #b71c1c; color: #fff; }
  .btn-wood { background: #5d4037; color: #fff; }
  .btn-gold { background: #b8860b; color: #fff; }
  .btn-gray { background: #757575; color: #fff; }
  .btn-orange { background: #e65100; color: #fff; }
  .sentence-btn {
    display: inline-block;
    padding: 8px 14px;
    border: 2px solid #8d6e63;
    background: #fff;
    border-radius: 6px;
    cursor: pointer;
    font-family: Georgia, serif;
    margin: 3px;
    font-size: 0.85rem;
    transition: all 0.15s;
  }
  .sentence-btn:hover { border-color: #b8860b; background: #fff8e1; }
  .sentence-btn.selected { background: #1a237e; color: #fff; border-color: #1a237e; }
  .result-just {
    background: #e8f5e9;
    border: 2px solid #1b5e20;
    color: #1b5e20;
    padding: 12px;
    border-radius: 8px;
    text-align: center;
    margin-bottom: 12px;
  }
  .result-unjust {
    background: #ffebee;
    border: 2px solid #b71c1c;
    color: #b71c1c;
    padding: 12px;
    border-radius: 8px;
    text-align: center;
    margin-bottom: 12px;
  }
  .start-screen { text-align: center; padding: 40px 16px; }
  .start-screen h2 { color: #3e2723; font-size: 1.5rem; margin-bottom: 10px; }
  .start-screen p { color: #444; max-width: 480px; margin: 0 auto 20px auto; line-height: 1.5; font-size: 0.9rem; }
  .progress-bar {
    width: 100%;
    height: 6px;
    background: #e0e0e0;
    border-radius: 3px;
    margin-top: 3px;
    overflow: hidden;
  }
  .progress-fill {
    height: 100%;
    background: #ffd700;
    border-radius: 3px;
    transition: width 0.4s ease;
  }
  .stat-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
    margin-top: 10px;
  }
  .stat-box {
    background: #f5f5f5;
    padding: 8px;
    border-radius: 6px;
    text-align: center;
    font-size: 0.8rem;
  }
  .stat-box .num { font-size: 1.1rem; font-weight: bold; }
  .end-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 8px;
    margin: 14px 0;
  }
  .end-box {
    background: #f5e6c8;
    padding: 10px;
    border-radius: 8px;
    text-align: center;
  }
  .end-box .num { font-size: 1.2rem; font-weight: bold; color: #3e2723; }
  .media-box {
    background: #fff3e0;
    border: 2px solid #ef6c00;
    border-radius: 8px;
    padding: 10px;
    margin-bottom: 12px;
    font-size: 0.85rem;
  }
  .media-box h4 { margin: 0 0 6px 0; color: #e65100; font-size: 0.9rem; }
  .media-headline {
